{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CricketLens: run app",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "CricketLens: build gallery",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/build_gallery.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "CricketLens: fetch cricketer photos",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/fetch_cricketers.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "CricketLens: train model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "CricketLens: retrain (rebuild embeddings)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "args": [
        "--rebuild"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}